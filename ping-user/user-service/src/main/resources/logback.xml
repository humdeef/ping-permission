<configuration debug="false" scan="false">
    <springProperty scope="context" name="spring.application.name" source="spring.application.name" defaultValue="user-service"/>
    <property name="FORMAT" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSS} [%thread] %level [bizTid:%X{bizTid}] %logger - %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.classic.PatternLayout">
                <pattern>${FORMAT}</pattern>
            </layout>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="console"/>
    </root>
</configuration>
