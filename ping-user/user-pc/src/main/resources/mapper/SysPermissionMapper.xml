<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ping.user.pc.mapper.SysPermissionMapper">

    <select id="findAllOrdered" resultType="com.ping.user.pc.entity.SysPermission">
        SELECT * FROM sys_permission ORDER BY sort ASC, id ASC
    </select>

    <select id="findByParentIdOrderBySort" resultType="com.ping.user.pc.entity.SysPermission">
        SELECT * FROM sys_permission WHERE parent_id = #{parentId} ORDER BY sort ASC
    </select>

</mapper>
