# 复制为 .env 后按需修改；所有值都有默认值，不创建 .env 也能一键启动。

# ---- 环境：dev / test / prod ----
# 决定加载 Nacos 中的 application-{env}.yml 与 {service}-{env}.yml
APP_ENV=dev

# ---- 宿主机端口（避免与本机已有服务冲突）----
WEB_HOST_PORT=5173
GATEWAY_HOST_PORT=9999
NACOS_HOST_PORT=18848
NACOS_GRPC_HOST_PORT=19848
NACOS_CONSOLE_HOST_PORT=18080
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379

# ---- 镜像 tag ----
# 默认取根 pom.xml 的 <revision>（./start.sh version 可查看），一般无需修改；
# 只在需要让多个版本镜像共存时覆盖。
# IMAGE_TAG=

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ping

# ---- Nacos 数据库（Nacos 使用 MySQL 存储，表由 init-sql/nacos-mysql.sql 初始化）----
NACOS_DB_NAME=nacos_config
NACOS_DB_USER=root
# 默认与 MYSQL_ROOT_PASSWORD 一致；使用默认 root 用户时可不填
# NACOS_DB_PASSWORD=123456

# ---- Nacos（本地开发关闭鉴权，但 3.x 镜像要求提供以下变量）----
NACOS_AUTH_TOKEN=cGluZy1wZXJtaXNzaW9uLWxvY2FsLWRldi10b2tlbi0zMi1ieXRlcy0=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security
# 默认鉴权关闭，客户端不填账号密码；若改为 NACOS_AUTH_ENABLE=true，请取消下面两行注释
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=nacos
